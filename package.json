{
  "name": "dsh-token-usage",
  "version": "1.0.0-local.1",
  "private": true,
  "type": "module",
  "description": "Settings token usage statistics with durable local history",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "scripts": { "build": "node tools/build.mjs", "test": "node --test test/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-settings"], "platform": "web" }
  }
}
